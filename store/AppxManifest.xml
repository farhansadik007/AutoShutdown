<?xml version="1.0" encoding="utf-8"?>
<!--
  MSIX manifest for AutoShutdown.
  Product identity is registered in Partner Center (Store ID 9NSHBM3HQ515).
  Bump Version here (pack.ps1 -Version does it too) for each submission.
-->
<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
  IgnorableNamespaces="rescap uap">

  <Identity
    Name="PaperCraneLabs.AutoShutdown-ShutdownTimerforPC"
    Publisher="CN=E029A42B-BCDE-43A9-9E99-03026508BB24"
    Version="1.0.0.0"
    ProcessorArchitecture="x64" />

  <Properties>
    <DisplayName>AutoShutdown - Shutdown Timer for PC</DisplayName>
    <PublisherDisplayName>PaperCrane Labs</PublisherDisplayName>
    <Logo>assets\StoreLogo.png</Logo>
  </Properties>

  <Dependencies>
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.19041.0" MaxVersionTested="10.0.26100.0" />
  </Dependencies>

  <Resources>
    <Resource Language="en-us" />
  </Resources>

  <Applications>
    <Application
      Id="AutoShutdown"
      Executable="AutoShutdown.exe"
      EntryPoint="Windows.FullTrustApplication">

      <uap:VisualElements
        DisplayName="AutoShutdown"
        Description="A shutdown timer with a pie clock: pick a duration, choose shutdown, restart, sleep, hibernate or lock, and walk away."
        BackgroundColor="#43766C"
        ForegroundText="light"
        Square150x150Logo="assets\Square150x150Logo.png"
        Square44x44Logo="assets\Square44x44Logo.png"
        Square310x310Logo="assets\Square310x310Logo.png"
        Wide310x150Logo="assets\Wide310x150Logo.png">

        <uap:DefaultTile
          ShortName="AutoShutdown"
          Square310x310Logo="assets\Square310x310Logo.png"
          Square150x150Logo="assets\Square150x150Logo.png"
          Wide310x150Logo="assets\Wide310x150Logo.png">
          <uap:ShowNameOnTiles>
            <uap:ShowOn Tile="square150x150Logo" />
            <uap:ShowOn Tile="wide310x150Logo" />
          </uap:ShowNameOnTiles>
        </uap:DefaultTile>

        <uap:SplashScreen Image="assets\SplashScreen.png" />
      </uap:VisualElements>
    </Application>
  </Applications>

  <Capabilities>
    <rescap:Capability Name="runFullTrust" />
  </Capabilities>
</Package>
