<Window x:Class="AutoShutdown.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:AutoShutdown.Controls"
        xmlns:converters="clr-namespace:AutoShutdown.Converters"
         Icon="AutoShutdown.ico"
        Title="AutoShutdown"
        Width="400"
        Height="690"
        WindowStyle="None"
        AllowsTransparency="True"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        Background="Transparent"
        Foreground="{StaticResource Text}"
        FontFamily="{StaticResource UiFont}"
        TextOptions.TextFormattingMode="Ideal"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">

    <Window.Resources>
        <converters:EnumToBoolConverter x:Key="EnumToBool" />

        <Style x:Key="PreviewDigit" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
            <Setter Property="FontSize" Value="34" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="Foreground" Value="#FFFFFF" />
            <Setter Property="Typography.NumeralAlignment" Value="Tabular" />
        </Style>
    </Window.Resources>

    <Border x:Name="Shell"
            Background="{StaticResource Bg}"
            BorderBrush="#26A9791C"
            BorderThickness="1"
            CornerRadius="16"
            VerticalAlignment="Top"
            SizeChanged="Shell_SizeChanged">
    <Grid x:Name="Root" ClipToBounds="True">

        <!-- Title bar -->
        <Grid Height="44"
              VerticalAlignment="Top"
              Background="Transparent"
              MouseLeftButtonDown="Header_MouseLeftButtonDown">
            <StackPanel Orientation="Horizontal" Margin="20,0,0,0" VerticalAlignment="Center">
                <Ellipse x:Name="StatusDot"
                         Width="8"
                         Height="8"
                         Fill="{StaticResource Mint}"
                         VerticalAlignment="Center" />
                <StackPanel Orientation="Horizontal" Margin="9,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="Auto"
                               FontSize="13.5"
                               FontWeight="ExtraBold"
                               Foreground="{StaticResource Accent}"
                               VerticalAlignment="Center" />
                    <TextBlock Text="Shutdown"
                               FontSize="13.5"
                               FontWeight="Bold"
                               Foreground="{StaticResource Text}"
                               VerticalAlignment="Center" />
                </StackPanel>
            </StackPanel>

            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        Margin="0,0,10,0">
                <Button Style="{StaticResource ChromeButton}" Click="Minimize_Click" ToolTip="Minimize">
                    <Path Data="M 0,0 L 10,0"
                          Stroke="{StaticResource Muted}"
                          StrokeThickness="1.3"
                          StrokeStartLineCap="Round"
                          StrokeEndLineCap="Round" />
                </Button>
                <Button Style="{StaticResource ChromeButton}" Click="Close_Click" ToolTip="Close">
                    <Path Data="M 0,0 L 9,9 M 9,0 L 0,9"
                          Stroke="{StaticResource Muted}"
                          StrokeThickness="1.3"
                          StrokeStartLineCap="Round"
                          StrokeEndLineCap="Round" />
                </Button>
            </StackPanel>
        </Grid>

        <!-- ================= SETUP ================= -->
        <Grid x:Name="SetupView" Margin="24,50,24,18">
            <StackPanel VerticalAlignment="Top">
                <TextBlock Text="Set a time."
                           FontFamily="{StaticResource UiFont}"
                           FontSize="29"
                           FontWeight="Bold"
                           Margin="0,2,0,0" />

                <TextBlock Text="Pick a duration, choose what happens, walk away."
                           Foreground="{StaticResource Muted}"
                           FontSize="11.5"
                           Margin="0,6,0,0"
                           TextWrapping="Wrap" />

                <Grid Width="180"
                      Height="180"
                      Margin="0,12,0,0"
                      HorizontalAlignment="Center">
                    <controls:RingMeter x:Name="PreviewRing" Progress="1" />
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock Text="{Binding SetupTimeText}" Style="{StaticResource PreviewDigit}" />
                        <TextBlock Text="{Binding SetupActionText}"
                                   Style="{StaticResource Eyebrow}"
                                   FontSize="8.5"
                                   Foreground="#FFFFFF"
                                   HorizontalAlignment="Center"
                                   Margin="0,7,0,0" />
                    </StackPanel>
                </Grid>

                <UniformGrid Rows="1" Columns="5" HorizontalAlignment="Stretch" Margin="0,14,0,0">
                    <Button Style="{StaticResource PresetButton}"
                            Content="5m"
                            Command="{Binding PresetCommand}"
                            CommandParameter="300"
                            Margin="3,0" />
                    <Button Style="{StaticResource PresetButton}"
                            Content="15m"
                            Command="{Binding PresetCommand}"
                            CommandParameter="900"
                            Margin="3,0" />
                    <Button Style="{StaticResource PresetButton}"
                            Content="30m"
                            Command="{Binding PresetCommand}"
                            CommandParameter="1800"
                            Margin="3,0" />
                    <Button Style="{StaticResource PresetButton}"
                            Content="1h"
                            Command="{Binding PresetCommand}"
                            CommandParameter="3600"
                            Margin="3,0" />
                    <Button Style="{StaticResource PresetButton}"
                            Content="2h"
                            Command="{Binding PresetCommand}"
                            CommandParameter="7200"
                            Margin="3,0" />
                </UniformGrid>

                <Border Style="{StaticResource Card}"
                        Margin="0,10,0,0"
                        Padding="10,8,10,10">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <StackPanel>
                            <RepeatButton Style="{StaticResource StepButton}"
                                          Command="{Binding AdjustCommand}"
                                          CommandParameter="h+">
                                <Path Data="M 0,6 L 6,0 L 12,6"
                                      Stroke="#8A7E62"
                                      StrokeThickness="1.4"
                                      StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round" />
                            </RepeatButton>
                            <TextBlock Text="{Binding HoursText}"
                                       Style="{StaticResource Digit}"
                                       FontSize="34"
                                       Width="74"
                                       Margin="0,2" />
                            <RepeatButton Style="{StaticResource StepButton}"
                                          Command="{Binding AdjustCommand}"
                                          CommandParameter="h-">
                                <Path Data="M 0,0 L 6,6 L 12,0"
                                      Stroke="#8A7E62"
                                      StrokeThickness="1.4"
                                      StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round" />
                            </RepeatButton>
                            <TextBlock Text="HOURS" Style="{StaticResource UnitLabel}" Margin="0,5,0,0" />
                        </StackPanel>

                        <TextBlock Text=":"
                                   FontFamily="{StaticResource UiFont}"
                                   FontSize="24"
                                   Foreground="{StaticResource Dim}"
                                   VerticalAlignment="Center"
                                   Margin="2,0,2,18" />

                        <StackPanel>
                            <RepeatButton Style="{StaticResource StepButton}"
                                          Command="{Binding AdjustCommand}"
                                          CommandParameter="m+">
                                <Path Data="M 0,6 L 6,0 L 12,6"
                                      Stroke="#8A7E62"
                                      StrokeThickness="1.4"
                                      StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round" />
                            </RepeatButton>
                            <TextBlock Text="{Binding MinutesText}"
                                       Style="{StaticResource Digit}"
                                       FontSize="34"
                                       Width="74"
                                       Margin="0,2" />
                            <RepeatButton Style="{StaticResource StepButton}"
                                          Command="{Binding AdjustCommand}"
                                          CommandParameter="m-">
                                <Path Data="M 0,0 L 6,6 L 12,0"
                                      Stroke="#8A7E62"
                                      StrokeThickness="1.4"
                                      StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round" />
                            </RepeatButton>
                            <TextBlock Text="MINUTES" Style="{StaticResource UnitLabel}" Margin="0,5,0,0" />
                        </StackPanel>

                        <TextBlock Text=":"
                                   FontFamily="{StaticResource UiFont}"
                                   FontSize="24"
                                   Foreground="{StaticResource Dim}"
                                   VerticalAlignment="Center"
                                   Margin="2,0,2,18" />

                        <StackPanel>
                            <RepeatButton Style="{StaticResource StepButton}"
                                          Command="{Binding AdjustCommand}"
                                          CommandParameter="s+">
                                <Path Data="M 0,6 L 6,0 L 12,6"
                                      Stroke="#8A7E62"
                                      StrokeThickness="1.4"
                                      StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round" />
                            </RepeatButton>
                            <TextBlock Text="{Binding SecondsText}"
                                       Style="{StaticResource Digit}"
                                       FontSize="34"
                                       Width="74"
                                       Margin="0,2" />
                            <RepeatButton Style="{StaticResource StepButton}"
                                          Command="{Binding AdjustCommand}"
                                          CommandParameter="s-">
                                <Path Data="M 0,0 L 6,6 L 12,0"
                                      Stroke="#8A7E62"
                                      StrokeThickness="1.4"
                                      StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round" />
                            </RepeatButton>
                            <TextBlock Text="SECONDS" Style="{StaticResource UnitLabel}" Margin="0,5,0,0" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <TextBlock Text="THEN" Style="{StaticResource Eyebrow}" Margin="0,16,0,0" />

                <Border Style="{StaticResource SegmentBox}"
                        Margin="0,8,0,0"
                        HorizontalAlignment="Stretch">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <RadioButton GroupName="Action"
                                     Style="{StaticResource ActionPill}"
                                     FontSize="10.5"
                                     Content="Shut down"
                                     IsChecked="{Binding Action, Converter={StaticResource EnumToBool}, ConverterParameter=Shutdown}" />
                        <RadioButton GroupName="Action"
                                     Style="{StaticResource ActionPill}"
                                     FontSize="10.5"
                                     Content="Restart"
                                     IsChecked="{Binding Action, Converter={StaticResource EnumToBool}, ConverterParameter=Restart}" />
                        <RadioButton GroupName="Action"
                                     Style="{StaticResource ActionPill}"
                                     FontSize="10.5"
                                     Content="Sleep"
                                     IsChecked="{Binding Action, Converter={StaticResource EnumToBool}, ConverterParameter=Sleep}" />
                        <RadioButton GroupName="Action"
                                     Style="{StaticResource ActionPill}"
                                     FontSize="10.5"
                                     Content="Hibernate"
                                     IsChecked="{Binding Action, Converter={StaticResource EnumToBool}, ConverterParameter=Hibernate}" />
                        <RadioButton GroupName="Action"
                                     Style="{StaticResource ActionPill}"
                                     FontSize="10.5"
                                     Content="Lock"
                                     IsChecked="{Binding Action, Converter={StaticResource EnumToBool}, ConverterParameter=Lock}" />
                    </StackPanel>
                </Border>

                <Button Style="{StaticResource PrimaryButton}"
                        Content="Start countdown"
                        FontSize="13.5"
                        Command="{Binding StartCommand}"
                        IsEnabled="{Binding CanStart}"
                        HorizontalAlignment="Stretch"
                        Margin="0,18,0,0" />

                <TextBlock Text="Enter starts · Esc closes"
                           FontSize="10"
                           Foreground="{StaticResource Muted}"
                           HorizontalAlignment="Center"
                           Margin="0,6,0,0" />

                <Button Content="♥ Support"
                        Style="{StaticResource LinkChip}"
                        HorizontalAlignment="Center"
                        Margin="0,2,0,0"
                        Click="Support_Click" />
            </StackPanel>
        </Grid>

        <!-- ================= COUNTDOWN ================= -->
        <Grid x:Name="CountdownView"
              Margin="24,50,24,20"
              Opacity="0"
              Visibility="Collapsed"
              RenderTransformOrigin="0.5,0.5">
            <Grid.RenderTransform>
                <ScaleTransform x:Name="ScreenScale" ScaleX="1" ScaleY="1" />
            </Grid.RenderTransform>

            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel x:Name="CountdownHeader">
                    <TextBlock Text="{Binding CountdownCaption}"
                               Style="{StaticResource Eyebrow}"
                               FontSize="10.5"
                               HorizontalAlignment="Center" />

                    <TextBlock Text="{Binding TargetTimeText, StringFormat='at {0}'}"
                               FontSize="10"
                               Foreground="{StaticResource Muted}"
                               HorizontalAlignment="Center"
                               Margin="0,6,0,0" />
                </StackPanel>

                <Grid x:Name="RingHost"
                      Width="300"
                      Height="300"
                      Margin="0,14,0,0"
                      HorizontalAlignment="Center"
                      RenderTransformOrigin="0.5,0.5">
                    <Grid.RenderTransform>
                        <ScaleTransform x:Name="RingHostScale" ScaleX="1" ScaleY="1" />
                    </Grid.RenderTransform>

                    <controls:RingMeter x:Name="Ring" Progress="1" />

                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock x:Name="TimeText"
                                   Text="00:00"
                                   FontFamily="{StaticResource UiFont}"
                                   FontSize="62"
                                   FontWeight="Bold"
                                   Foreground="#303841"
                                   Typography.NumeralAlignment="Tabular"
                                   HorizontalAlignment="Center"
                                   RenderTransformOrigin="0.5,0.5">
                            <TextBlock.RenderTransform>
                                <ScaleTransform x:Name="TimeScale" ScaleX="1" ScaleY="1" />
                            </TextBlock.RenderTransform>
                        </TextBlock>

                        <TextBlock x:Name="ActionText"
                                   Text="{Binding CountdownActionText}"
                                   HorizontalAlignment="Center"
                                   FontSize="12"
                                   FontWeight="Bold"
                                   Foreground="#303841"
                                   Margin="0,10,0,0" />
                    </StackPanel>
                </Grid>

                <Grid x:Name="CancelHost" Margin="0,26,0,0">
                    <Button Content="+5 min"
                            Style="{StaticResource PresetButton}"
                            MinWidth="72"
                            HorizontalAlignment="Left"
                            Command="{Binding AddFiveMinutesCommand}" />
                    <Button Content="Cancel"
                            Style="{StaticResource DangerChip}"
                            HorizontalAlignment="Right"
                            Command="{Binding RequestCancelCommand}" />
                </Grid>
            </StackPanel>
        </Grid>

        <!-- ================= CANCEL CONFIRMATION ================= -->
        <Grid x:Name="ConfirmOverlay"
              Background="#4D303030"
              Opacity="0"
              Visibility="Collapsed"
              IsHitTestVisible="False">
            <Border x:Name="ConfirmCard"
                    Style="{StaticResource Card}"
                    Width="340"
                    Padding="22"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    RenderTransformOrigin="0.5,0.5">
                <StackPanel>
                    <TextBlock Text="Cancel the countdown?"
                               FontSize="18"
                               FontWeight="Bold" />
                    <TextBlock Text="Your PC will stay on. Nothing has happened yet."
                               Foreground="{StaticResource Muted}"
                               FontSize="11.5"
                               Margin="0,7,0,0"
                               TextWrapping="Wrap" />

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
                        <Button Content="Keep counting"
                                Style="{StaticResource PresetButton}"
                                Height="34"
                                FontSize="11.5"
                                Command="{Binding DismissConfirmCommand}" />
                        <Button Content="Cancel countdown"
                                Style="{StaticResource DangerChipSolid}"
                                Height="34"
                                FontSize="11.5"
                                Margin="8,0,0,0"
                                Command="{Binding ConfirmCancelCommand}" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>

        <!-- ================= FINISH ================= -->
        <Grid x:Name="FinishOverlay"
              Background="#F2303030"
              Opacity="0"
              Visibility="Collapsed"
              IsHitTestVisible="True">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock x:Name="FinishHeadline"
                           Text="Goodnight."
                           FontFamily="{StaticResource UiFont}"
                           FontSize="38"
                           FontWeight="Bold"
                           Foreground="#F5F5F5"
                           HorizontalAlignment="Center" />
                <TextBlock x:Name="FinishDetail"
                           Text="Shutting Windows down."
                           Foreground="#B9C2C2"
                           FontSize="11.5"
                           Margin="0,10,0,0"
                           HorizontalAlignment="Center" />
            </StackPanel>
        </Grid>

        <!-- Crisp window edge on light glass -->
        <Border x:Name="ShellEdge"
                BorderBrush="#26000000"
                BorderThickness="1"
                CornerRadius="16"
                IsHitTestVisible="False" />
    </Grid>
    </Border>
</Window>
